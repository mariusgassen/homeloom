# Copy to .env for local development. In Coolify, set these as environment variables instead.

# --- Postgres (bundled as homeloom-postgres) ---
POSTGRES_USER=homeloom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homeloom

# --- authentik ---
# Issuer of the OAuth2/OpenID provider, e.g. https://auth.example.com/application/o/homeloom/
# The provider needs a signing key so access tokens are verifiable JWTs.
OIDC_ISSUER_URL=https://auth.example.com/application/o/homeloom/
# Client IDs whose access tokens the API accepts (PWA, iOS app, MCP, ...), comma separated.
OIDC_CLIENT_IDS=homeloom-pwa

# --- API ---
# Browser origins allowed to call the API directly, comma separated. Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# USER_CACHE_TTL=5m

# --- Coming with the features that use them ---
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=
# HOME_ASSISTANT_URL=https://ha.example.com
# HOME_ASSISTANT_TOKEN=
