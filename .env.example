# Copy to .env for local development. In Coolify, set these as environment variables instead.

# --- Postgres (bundled as homeloom-postgres) ---
POSTGRES_USER=homeloom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homeloom

# Where the app is served (http://localhost:3000 with docker-compose.dev.yml). The login callback
# is PUBLIC_URL/auth/callback; register it in authentik.
PUBLIC_URL=https://homeloom.example.com

# --- authentik ---
# Issuer of the OAuth2/OpenID provider, e.g. https://auth.example.com/application/o/homeloom/
# The provider needs a signing key so tokens are verifiable JWTs.
OIDC_ISSUER_URL=https://auth.example.com/application/o/homeloom/
# Confidential client used by the browser login. The secret never leaves the API.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Client IDs of other authentik providers whose access tokens the API accepts, comma-separated,
# e.g. one for an MCP client such as Claude that uses PUBLIC_URL/mcp.
# OIDC_CLIENT_IDS=

# --- API ---
LOG_LEVEL=info
# USER_CACHE_TTL=5m
# How long a browser stays signed in.
# SESSION_TTL=720h

# --- Cooking (optional) ---
# Mealie is reached through its MCP server. Without MEALIE_MCP_URL the Cook tab says cooking
# isn't set up. The token is the MCP server's bearer token.
# MEALIE_MCP_URL=https://mealie-mcp.example.com/mcp
# MEALIE_MCP_TOKEN=
# Mealie itself, only for "Open in Mealie" links.
# MEALIE_URL=https://mealie.example.com
# Claude picks recipes by mood and is the assistant. Without a key, suggestions are random and the
# assistant is off.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Smart home (optional) ---
# Without HOME_ASSISTANT_URL the Home tab is off. Each person connects their own Home Assistant
# account from the Home tab (Home Assistant's sign-in; nothing to register there). The URL must
# be reachable from the browser and from the API. Only scenes and lights are used.
# HOME_ASSISTANT_URL=https://ha.example.com
# Encrypts the stored Home Assistant and Plex tokens: 32 random bytes, base64 (openssl rand -base64 32).
# Changing it means everyone connects again.
# HOMELOOM_SECRET_KEY=

# --- Movies and shows (optional) ---
# On whenever HOMELOOM_SECRET_KEY is set: each person signs in to Plex from Us › Movies & shows,
# nothing to register. The API must reach the Plex servers. Set to false to turn it off.
# PLEX_ENABLED=true

# --- Notifications (optional) ---
# Web Push with VAPID. Without the key pair the notification switch in Settings is hidden.
# Generate a pair once with: docker compose run --rm homeloom-api vapid-keys
# (or npx web-push generate-vapid-keys; same format).
# Changing the keys means every device turns notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Who sends them, for the push services: an https URL or e-mail address. Defaults to PUBLIC_URL.
# VAPID_SUBJECT=

# --- Calls ---
# Voice and video calls run on the bundled LiveKit server (homeloom-livekit). Clients reach it
# through PUBLIC_URL; the server's firewall must let UDP 7882 and TCP 7881 in.
# The secret must be at least 32 characters: openssl rand -base64 32
# LIVEKIT_API_KEY=homeloom
LIVEKIT_API_SECRET=
# Talking to Homeloom in a call (the phone in the assistant) needs ANTHROPIC_API_KEY and an OpenAI
# key for speech (gpt-4o-transcribe and gpt-4o-mini-tts). Without it only calls between people work.
# OPENAI_API_KEY=
# Claude model for calls; a faster one keeps answers snappy.
# VOICE_LLM_MODEL=claude-sonnet-5-5

# --- Photo storage (optional) ---
# The bundled homeloom-garage is an S3 store. With a key pair, new moment and note photos go there instead
# of Postgres; photos from before stay where they are and still show. Garage wants this format:
#   S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)
#   S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
# Garage imports the key on start. It never reuses a key id, so a new secret needs a new id too.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=homeloom
# Another S3-compatible store instead (then create the bucket and key there yourself):
# S3_ENDPOINT=http://homeloom-garage:3900
# S3_REGION=garage

# --- Reminders ---
# Where the household lives (IANA name). Repeating reminders keep their time of day here.
# TIME_ZONE=Europe/Berlin
