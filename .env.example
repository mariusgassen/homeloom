# Copy to .env for local development. In Coolify, set these as environment variables instead.

# --- Postgres (bundled as homeloom-postgres) ---
POSTGRES_USER=homeloom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homeloom

# Where the app is served (http://localhost:3000 with docker-compose.dev.yml). The login callback
# is PUBLIC_URL/auth/callback; register it in authentik.
PUBLIC_URL=https://homeloom.example.com

# --- authentik ---
# Issuer of the OAuth2/OpenID provider, e.g. https://auth.example.com/application/o/homeloom/
# The provider needs a signing key so tokens are verifiable JWTs.
OIDC_ISSUER_URL=https://auth.example.com/application/o/homeloom/
# Confidential client used by the browser login. The secret never leaves the API.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- API ---
LOG_LEVEL=info
# USER_CACHE_TTL=5m
# How long a browser stays signed in.
# SESSION_TTL=720h

# --- Cooking (optional) ---
# Without MEALIE_URL the Cook tab says cooking isn't set up. The token comes from Mealie's
# user profile > API tokens.
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=
# Shopping list to fill; empty uses the list that changed last.
# MEALIE_SHOPPING_LIST_ID=
# Claude picks recipes by mood. Without a key, suggestions are random.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Smart home (optional) ---
# Without HOME_ASSISTANT_URL the Home tab says the smart home isn't connected. The token is a
# long-lived access token from your Home Assistant profile. Only scenes and lights are used.
# HOME_ASSISTANT_URL=https://ha.example.com
# HOME_ASSISTANT_TOKEN=
# Scene that dinner mode turns on.
# DINNER_SCENE=scene.dinner
